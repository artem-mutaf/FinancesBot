# Caddy — веб-сервер перед приложением.
# Достаточно указать домен: Caddy сам получит бесплатный HTTPS-сертификат Let's Encrypt,
# будет продлевать его и перенаправлять http:// на https://.
# {$DOMAIN} — значение переменной окружения DOMAIN (из .env через docker-compose.yml).

{$DOMAIN} {
	# Все запросы — в контейнер app на порт 8080 (по внутренней сети Docker)
	reverse_proxy app:8080
}
