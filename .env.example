# Образец настроек для сервера. На сервере:  cp .env.example .env  — и заполнить.
# Файл .env содержит секреты и в git НЕ попадает (см. .gitignore).

# Адрес сайта без https:// (например, с DuckDNS)
DOMAIN=artem-finance.duckdns.org

# Токен ОСНОВНОГО бота от @BotFather
BOT_TOKEN=1234567890:AAAA-замени-на-свой

# Пароль базы данных. Только латинские буквы и цифры (точка с запятой сломает строку подключения).
# Сгенерировать на сервере:  openssl rand -hex 24
POSTGRES_PASSWORD=замени-на-случайный
